# MODELO PARA RAILWAY / PRODUCAO
# Cadastre estas variáveis no serviço do Railway.
# Não reutilize os segredos do ambiente local já expostos.
# Depois do primeiro deploy, ajuste APP_URL e BASE_URL para o domínio público real.

# Ambiente
NODE_ENV=production
PORT=3000

# URLs públicas reais do backend no Railway
APP_URL=https://api.seudominio.com
BASE_URL=https://api.seudominio.com

# Domínios autorizados no CORS
# Inclua aqui o app mobile/web, painel admin e, se necessário, localhost temporariamente.
CORS_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com

# Comportamento seguro para produção
HTTP_LOGGING=false
SEED_ON_BOOT=false
SWAGGER_ENABLED=false
UPLOADS_PUBLIC=false

# Banco de dados PostgreSQL do Railway
# Se usar o plugin PostgreSQL do Railway, copie os valores gerados para estes campos.
DB_HOST=your-railway-postgres-host
DB_PORT=5432
DB_USERNAME=your-railway-postgres-user
DB_PASSWORD=replace-with-a-strong-db-password
DB_DATABASE=navegaja
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Webhook interno de pagamentos
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# E-mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=replace-with-your-app-password

# PIX
PIX_KEY=replace-with-your-pix-key
PIX_MERCHANT_NAME=NavegaJa Transportes
PIX_MERCHANT_CITY=Manaus
PIX_TXID_PREFIX=NVGJ

# Clima / hidrologia
OPENWEATHER_API_KEY=replace-with-your-openweathermap-api-key
ANA_PROXY_URL=https://navegajaana-proxy.mguibtech.workers.dev/

# Firebase / FCM
FIREBASE_PROJECT_ID=navegajaapp-cf361
FIREBASE_CLIENT_EMAIL=replace-with-your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=navegajaapp-cf361.appspot.com
