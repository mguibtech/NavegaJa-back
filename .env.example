# MODELO PARA TESTE LOCAL / REDE INTERNA
# Copie para .env e preencha os valores reais.
# Para produção use .env.production.example como base.

# Ambiente
NODE_ENV=development
PORT=3000

# URL pública da API usada para links de uploads e webhooks locais.
# Se o app mobile acessar pela rede local, troque pelo IP real da máquina.
APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Frontends autorizados a acessar a API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Comportamento da aplicação
HTTP_LOGGING=true
SEED_ON_BOOT=false
SWAGGER_ENABLED=true
UPLOADS_PUBLIC=true

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=navegaja
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Webhook interno de pagamentos
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# E-mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# PIX
PIX_KEY=your-pix-key
PIX_MERCHANT_NAME=NavegaJa Transportes
PIX_MERCHANT_CITY=Manaus
PIX_TXID_PREFIX=NVGJ

# Clima / hidrologia
OPENWEATHER_API_KEY=your-openweathermap-api-key
ANA_PROXY_URL=https://your-ana-proxy.example.workers.dev/

# Firebase / FCM
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
