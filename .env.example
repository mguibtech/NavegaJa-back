# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=navegaja

# JWT
JWT_ACCESS_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# E-mail (Gmail SMTP - gratuito)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# PIX Configuration (Manual/Gratuito)
PIX_KEY=your-pix-key  # CPF, CNPJ, telefone, email ou chave aleatória
PIX_MERCHANT_NAME=Your Business Name
PIX_MERCHANT_CITY=Your City
PIX_TXID_PREFIX=NVGJ  # Prefixo para identificar transações

# OpenWeatherMap API (FREE - 1.000 chamadas/dia)
# Cadastre-se grátis em: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Firebase (Storage / Push)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opcional, mas recomendado se o bucket nao for {projectId}.appspot.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
APP_URL=http://localhost:3000
